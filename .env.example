# Copy to .env and adjust. .env is gitignored.

# Where the browser reaches the app. In development this is the Vite dev server.
PUBLIC_URL=http://localhost:5173
API_PORT=8787

# Session signing secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# preview = also serve drafts and content in review (labelled in the UI)
# published = serve only content whose review.status is "published"
CONTENT_STAGE=preview

# SQLite file (created on first run).
# DATABASE_PATH=data/thread-bible.db

# Optional: licensed translations through API.Bible (https://scripture.api.bible).
# Pairs of <our id>:<API.Bible bible id>, comma-separated.
# API_BIBLE_KEY=
# API_BIBLE_BIBLES=
