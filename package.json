{
  "name": "the-thread-bible",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch-path=server --watch-path=shared --watch-path=content --import tsx server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node --import tsx server/start.ts",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "db:generate": "drizzle-kit generate",
    "scripture:fetch": "node --import tsx server/scripts/fetch-scripture.ts",
    "scripture:import": "node --import tsx server/scripts/import-scripture.ts",
    "setup": "npm run scripture:fetch && npm run scripture:import",
    "content:check": "node --import tsx server/scripts/check-content.ts",
    "content:check:release": "node --import tsx server/scripts/check-content.ts --release",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.0",
    "better-auth": "^1.7.6",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
